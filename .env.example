# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Tool APIs ─────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-your_firecrawl_key
SERPAPI_KEY=your_serpapi_key
APIFY_API_TOKEN=your_apify_api_token
# Optional override for actor id (default is APIFY official Twitter/X scraper)
# APIFY_TWITTER_ACTOR_ID=61RPP7dywgiy0JPD0

# ── Scrape.do (free 1000 req/month — anti-bot fallback) ──
# Sign up free at https://scrape.do → Dashboard → copy token
SCRAPE_DO_TOKEN=

# ── AI ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Legacy (no longer used) ───────────────────────────────
# HUGGING_FACE_API_KEY=your_hugging_face_api_key
# HUGGING_FACE_MODEL=Qwen/Qwen3-32B
# HUGGING_FACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Optional (Reddit public JSON API works without keys) ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Optional (Meta Ad Library uses Firecrawl scrape, no token needed) ──
META_ADS_TOKEN=

# ── MiroFish Synthetic (existing VPS 167.71.230.193) ──────
# Run: npx tsx scripts/mirofish-bootstrap.ts  (pointed at MIROFISH_BASE_URL)
MIROFISH_BASE_URL=http://167.71.230.193:5001
MIROFISH_SIMULATIONS={"vector agents":"sim_xxx","lilian":"sim_xxx"}

# ── MiroFish Live (real VPS 168.144.36.78) ────────────────
# 1. SSH: place Groq+Zep in /opt/mirofish/.env, docker compose up -d
# 2. Run: MIROFISH_BASE_URL=http://168.144.36.78:5001 npx tsx scripts/mirofish-bootstrap-auto.ts "Product" scripts/seeds/vector-agents.txt
#    (On free Groq tier, seed is auto-trimmed; override with MIROFISH_ONTOLOGY_MAX_BYTES if needed.)
# 3. Paste the printed line below. Example shape:
MIROFISH_LIVE_BASE_URL=http://168.144.36.78:5001
MIROFISH_LIVE_SIMULATIONS={"vector agents":"sim_xxx","lilian":"sim_xxx","vectoragents":"sim_xxx","vector":"sim_xxx","ai sdr":"sim_xxx","the product":"sim_xxx"}
# Optional fallback when product extraction is ambiguous/unset:
# MIROFISH_LIVE_DEFAULT_SIMULATION_ID=sim_xxx
# Live sample size per query (1-6). Keep 1 in strict serial mode; raise gradually.
# MIROFISH_LIVE_MAX_AGENTS=1
