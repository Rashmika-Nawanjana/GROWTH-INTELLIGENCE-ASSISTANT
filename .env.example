# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Tool APIs ─────────────────────────────────────────────
FIRECRAWL_API_KEY=fc-your_firecrawl_key
SERPAPI_KEY=your_serpapi_key

# ── AI ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Optional (Reddit public JSON API works without keys) ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Optional (Meta Ad Library uses Firecrawl scrape, no token needed) ──
META_ADS_TOKEN=
